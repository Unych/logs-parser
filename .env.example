APP_NAME="Logs Parser"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=logs
DB_USERNAME=app
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

LOG_IMPORT_BATCH_SIZE=1000
LOG_IMPORT_MAX_FILE_MB=512
STATS_CACHE_TTL=300
UPLOAD_THROTTLE_PER_MIN=10

UID=1000
GID=1000
